# ECCCO Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# REQUIRED VARIABLES (All Environments)
# ============================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database"

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ============================================
# REQUIRED IN PRODUCTION ONLY
# ============================================

# Security - Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-32-character-minimum-encryption-key-here"

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Admin & Developer Authorization (comma-separated Clerk user IDs)
# Get user IDs from: Clerk Dashboard > Users > click on user > copy User ID
# Format: user_xxxxxxxxxxxxx,user_yyyyyyyyyyyyy
ADMIN_USER_IDS="user_your_admin_clerk_user_id_here"
DEVELOPER_USER_IDS="user_your_developer_clerk_user_id_here"

# AI Services
GROQ_API_KEY="gsk_..."  # Free tier available at console.groq.com

# Caching (Redis)
REDIS_URL="redis://default:password@host:port"

# Monitoring (Sentry - https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN="https://...@o123456.ingest.sentry.io/123456"
SENTRY_DSN="https://...@o123456.ingest.sentry.io/123456"
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"
SENTRY_AUTH_TOKEN="sntryu_..."

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel (auto-generated - no need to set manually)
VERCEL_OIDC_TOKEN=auto_generated_by_vercel_cli
