# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Admin & Developer Authorization
# Add Clerk user IDs here (comma-separated for multiple admins/developers)
# Get user IDs from: Clerk Dashboard > Users > click on user > copy User ID
# Format: user_xxxxxxxxxxxxx,user_yyyyyyyyyyyyy
ADMIN_USER_IDS=user_your_admin_clerk_user_id_here
DEVELOPER_USER_IDS=user_your_developer_clerk_user_id_here

# Vercel (auto-generated)
VERCEL_OIDC_TOKEN=auto_generated_by_vercel_cli
