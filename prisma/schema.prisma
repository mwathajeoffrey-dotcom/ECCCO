generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  name         String?
  sessionId    String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  examSessions ExamSession[]

  @@index([sessionId])
}

model Module {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  ageGroup    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topics      Topic[]

  @@index([ageGroup])
}

model Topic {
  id           String        @id @default(cuid())
  name         String
  description  String?
  moduleId     String
  category     String        @default("general")
  subcategory  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  examSessions ExamSession[]
  questions    Question[]
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, name])
  @@index([moduleId])
  @@index([category])
}

model Question {
  id           String   @id @default(cuid())
  question     String
  options      String
  correctIndex Int
  explanation  String
  references   String
  difficulty   String   @default("medium")
  topicId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  topic        Topic    @relation(fields: [topicId], references: [id])

  @@index([topicId])
  @@index([difficulty])
}

model ExamSession {
  id             String    @id @default(cuid())
  userId         String?
  sessionId      String
  topicId        String
  topicName      String
  questions      String
  questionsData  String?
  answers        String
  answersData    String?
  score          Int?
  totalQuestions Int       @default(0)
  correctAnswers Int       @default(0)
  totalTime      Int?
  timeSpent      Int?
  completed      Boolean   @default(false)
  completedAt    DateTime?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  topic          Topic     @relation(fields: [topicId], references: [id])
  user           User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([topicId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([completedAt])
}
