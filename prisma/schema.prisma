// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Topic {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id           String   @id @default(cuid())
  question     String
  options      String   // JSON string of options array
  correctIndex Int      // Index of correct answer (0-based)
  explanation  String
  references   String   // JSON string of references array
  difficulty   String   @default("medium") // easy, medium, hard
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([topicId])
  @@index([difficulty])
}

model ExamSession {
  id          String   @id @default(cuid())
  userId      String?  // Optional user ID for tracking
  sessionId   String   @unique // Browser session identifier
  topicId     String
  questions   String   // JSON string of question IDs array
  answers     String   // JSON string of user answers array
  score       Int?
  totalTime   Int?     // Time taken in seconds
  completed   Boolean  @default(false)
  
  // Device and Location Analytics
  deviceInfo  String?  // JSON string with device details
  userAgent   String?  // Browser user agent
  ipAddress   String?  // User IP address
  location    String?  // JSON string with location data (country, city, etc.)
  screenResolution String? // Screen resolution
  timezone    String?  // User timezone
  referrer    String?  // How they got to the site
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([topicId])
  @@index([sessionId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  sessionId   String   // Browser session identifier
  eventType   String   // 'page_view', 'exam_start', 'exam_complete', 'question_answered', etc.
  eventData   String?  // JSON string with event-specific data
  
  // Device and Location Data
  deviceInfo  String?  // JSON: {type: 'mobile/desktop/tablet', os: 'iOS/Android/Windows', browser: 'Chrome/Safari'}
  userAgent   String?  // Full user agent string
  ipAddress   String?  // User IP (hashed for privacy)
  location    String?  // JSON: {country: 'US', city: 'New York', region: 'NY'}
  screenSize  String?  // JSON: {width: 1920, height: 1080}
  timezone    String?  // User timezone
  referrer    String?  // Referring page/site
  
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}

model DailyStats {
  id              String   @id @default(cuid())
  date            DateTime @unique
  uniqueDevices   Int      @default(0)
  totalSessions   Int      @default(0)
  examsStarted    Int      @default(0)
  examsCompleted  Int      @default(0)
  topCountries    String?  // JSON array of top countries
  topDeviceTypes  String?  // JSON array of device type breakdown
  topTopics       String?  // JSON array of most popular topics
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

model UserProgress {
  id               String   @id @default(cuid())
  userId           String
  topicId          String
  totalQuestions   Int      @default(0)
  correctAnswers   Int      @default(0)
  averageTime      Float?   // Average time per question
  lastStudied      DateTime @default(now())
  strengthLevel    String   @default("beginner") // beginner, intermediate, advanced
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId])
}

// Advanced Learning Analytics Models
model LearningSession {
  id                String   @id @default(cuid())
  userId            String
  sessionId         String   // Browser session identifier
  startTime         DateTime
  endTime           DateTime?
  topicId           String
  questionsAttempted Int     @default(0)
  correctAnswers    Int      @default(0)
  timeSpent         Int      @default(0) // in seconds
  difficultyLevel   Int      @default(1)
  completionRate    Float    @default(0.0)
  confidenceScores  String?  // JSON array of confidence ratings
  responsePatterns  String?  // JSON array of detailed response data
  learningObjectives String? // JSON array of learning goals
  metadata          String?  // JSON object for additional data
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([topicId])
  @@index([sessionId])
  @@index([startTime])
  @@index([difficultyLevel])
}

model LearningInsight {
  id               String   @id @default(cuid())
  userId           String
  insightType      String   // 'strength', 'weakness', 'improvement', 'recommendation'
  category         String   // Topic or skill area
  title            String
  description      String
  evidence         String   // JSON array of supporting evidence
  confidence       Float    // 0-1 confidence score
  actionItems      String   // JSON array of recommended actions
  priority         String   // 'low', 'medium', 'high', 'critical'
  estimatedImpact  Float    // 0-1 estimated learning impact
  isActive         Boolean  @default(true)
  acknowledgedAt   DateTime?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([insightType])
  @@index([priority])
  @@index([isActive])
  @@index([createdAt])
}

model AdaptiveRecommendation {
  id                  String   @id @default(cuid())
  userId              String
  recommendationType  String   // 'question', 'topic', 'study_plan', 'guideline', 'practice_mode'
  title               String
  description         String
  reasoning           String
  targetTopics        String   // JSON array of topic IDs
  estimatedDifficulty Int      @default(1)
  estimatedTime       Int      @default(30) // in minutes
  expectedOutcome     String
  confidence          Float    // 0-1 confidence in recommendation
  algorithm           String   // Algorithm that generated this
  factors             String   // JSON array of factors considered
  metadata            String?  // JSON object for additional data
  
  isActive            Boolean  @default(true)
  acceptedAt          DateTime?
  completedAt         DateTime?
  feedbackRating      Int?     // 1-5 user rating
  feedbackComment     String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([recommendationType])
  @@index([isActive])
  @@index([createdAt])
  @@index([confidence])
}

model StudyPlan {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String
  totalDuration   Int      // in days
  dailyGoal       Int      // in minutes
  topics          String   // JSON array of topic configurations
  milestones      String   // JSON array of milestone definitions
  adaptations     String   // JSON array of plan modifications
  
  isActive        Boolean  @default(true)
  startedAt       DateTime?
  completedAt     DateTime?
  progressData    String?  // JSON object tracking progress
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([startedAt])
}

model PerformanceMetric {
  id              String   @id @default(cuid())
  userId          String
  metricType      String   // 'overall', 'topic', 'difficulty', 'velocity', 'cognitive_load'
  metricKey       String   // Specific metric identifier
  value           Float    // Metric value
  metadata        String?  // JSON object with additional metric data
  calculatedAt    DateTime
  
  createdAt       DateTime @default(now())

  @@unique([userId, metricType, metricKey, calculatedAt])
  @@index([userId])
  @@index([metricType])
  @@index([calculatedAt])
}

model LearningGoal {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String
  targetTopics    String   // JSON array of topic IDs
  targetAccuracy  Float?   // Target accuracy percentage
  targetTime      Int?     // Target completion time
  deadline        DateTime?
  
  status          String   @default("active") // 'active', 'completed', 'paused', 'abandoned'
  progress        Float    @default(0.0) // 0-1 completion percentage
  achievements    String?  // JSON array of milestones reached
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([deadline])
}

model QuestionAnalytics {
  id              String   @id @default(cuid())
  questionId      String
  userId          String?  // Optional for anonymous analytics
  sessionId       String
  
  // Response Data
  selectedAnswer  Int      // Index of selected answer
  isCorrect       Boolean
  responseTime    Int      // Time taken in milliseconds
  attempts        Int      @default(1)
  hintsUsed       Int      @default(0)
  confidenceLevel Int?     // 1-5 self-reported confidence
  difficultyRating Int?    // 1-5 user perception of difficulty
  
  // Context Data
  questionOrder   Int      // Position in the exam/session
  previousCorrect Boolean? // Whether previous question was correct
  cumulativeScore Float?   // Running accuracy at this point
  timeOfDay       String?  // Morning, afternoon, evening
  dayOfWeek       String?  // Monday, Tuesday, etc.
  
  createdAt       DateTime @default(now())

  @@index([questionId])
  @@index([userId])
  @@index([sessionId])
  @@index([isCorrect])
  @@index([responseTime])
  @@index([createdAt])
}