generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Bookmark {
  id         String   @id
  userId     String
  questionId String
  category   String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

model EvidenceReference {
  id                 String   @id
  referenceId        String   @unique
  category           String
  name               String
  organization       String?
  year               Int
  summary            String
  keyRecommendations String
  clinicalPearls     String
  evidenceLevel      String
  citation           String
  references         String
  topics             String?
  journal            String?
  doi                String?
  pmid               String?
  published          Boolean  @default(true)
  featured           Boolean  @default(false)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  createdBy          String?
  updatedBy          String?

  @@index([category])
  @@index([displayOrder])
  @@index([featured])
  @@index([published])
  @@index([referenceId])
  @@index([year])
}

model ExamAttempt {
  id             String   @id
  userId         String
  examType       String
  score          Int
  totalQuestions Int
  passed         Boolean
  timeSpent      Int?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([examType])
  @@index([passed])
  @@index([userId])
}

model ExamSession {
  id        String   @id
  userId    String?
  sessionId String   @unique
  topicId   String
  questions String
  answers   String
  score     Int?
  totalTime Int?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([createdAt])
  @@index([sessionId])
  @@index([topicId])
  @@index([userId])
}

model Feedback {
  id         String    @id
  userId     String?
  userName   String?
  userEmail  String
  type       String
  category   String?
  subject    String
  message    String
  pageUrl    String?
  userAgent  String?
  status     String    @default("new")
  priority   String    @default("medium")
  assignedTo String?
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime

  @@index([createdAt])
  @@index([priority])
  @@index([status])
  @@index([type])
  @@index([userEmail])
}

model Question {
  id           String   @id
  question     String
  options      String
  correctIndex Int
  explanation  String
  references   String
  difficulty   String   @default("medium")
  topicId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Topic        Topic    @relation(fields: [topicId], references: [id])

  @@index([difficulty])
  @@index([topicId])
}

model QuestionAttempt {
  id             String   @id
  userId         String
  questionId     String
  topicId        String?
  selectedAnswer Int
  isCorrect      Boolean
  timeSpent      Int?
  attemptMode    String
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isCorrect])
  @@index([questionId])
  @@index([userId])
}

model QuestionRating {
  id         String   @id
  userId     String
  questionId String
  stars      Int
  helpful    Boolean?
  feedback   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([createdAt])
  @@index([questionId])
  @@index([stars])
  @@index([userId])
}

model QuizAttempt {
  id             String   @id
  userId         String
  mode           String
  topicId        String?
  difficulty     String?
  score          Int
  totalQuestions Int
  timeSpent      Int?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([mode])
  @@index([userId])
}

model Topic {
  id          String     @id
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  Question    Question[]
}

model User {
  id              String            @id
  clerkUserId     String            @unique
  email           String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Bookmark        Bookmark[]
  ExamAttempt     ExamAttempt[]
  QuestionAttempt QuestionAttempt[]
  QuestionRating  QuestionRating[]
  QuizAttempt     QuizAttempt[]
  UserProfile     UserProfile?
  UserNote        UserNote[]

  @@index([clerkUserId])
  @@index([createdAt])
  @@index([email])
}

model UserProfile {
  id                   String   @id
  userId               String   @unique
  specialty            String?
  experienceLevel      String?
  organization         String?
  role                 String?
  focusAreas           String?
  difficultyPreference String   @default("medium")
  studyGoals           String?
  preferredMode        String   @default("practice")
  dailyGoal            Int      @default(10)
  emailNotifications   Boolean  @default(true)
  weeklyDigest         Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  User                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([experienceLevel])
  @@index([specialty])
  @@index([userId])
}

model UserNote {
  id           String   @id @default(cuid())
  userId       String
  title        String?
  content      String   @db.Text
  
  // Quiz/Question related (legacy)
  questionId   String?
  questionText String?
  category     String?
  
  // Clinical Evidence Search related (NEW)
  searchQuery       String?  // The evidence search query
  evidenceSummary   String?  @db.Text // AI synthesis they were reading
  specialty         String?  // e.g., "Emergency Medicine", "ICU"
  patientContext    String?  // e.g., "Elderly patient with comorbidities"
  
  // Organization
  tags         String[]
  
  // Versioning support for tracking guideline updates
  version      Int      @default(1)
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([category])
  @@index([searchQuery])
  @@index([specialty])
}

model QuizTemplate {
  id                  String   @id
  name                String
  description         String?
  createdBy           String   // User ID who created the template
  topicId             String?
  questionIds         String   // JSON array of question IDs

  // Template Settings
  pointsPerQuestion   Int      @default(1000)
  timePerQuestion     Int      @default(30)
  showCorrectAnswers  Boolean  @default(true)
  playSound           Boolean  @default(false)

  isPublic            Boolean  @default(false) // Can other users use this template
  usageCount          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime

  @@index([createdBy])
  @@index([topicId])
  @@index([isPublic])
  @@index([createdAt])
}

// ============================================
// QUIZ ARENA - Live Competitive Quiz Platform
// ============================================

model QuizSession {
  id                String        @id
  title             String
  description       String?
  accessCode        String        @unique // 6-digit code
  hostId            String        // User who created it

  // Session State
  status            String        @default("LOBBY") // LOBBY, QUESTION, ANSWER, LEADERBOARD, FINISHED
  currentQuestion   Int           @default(0)

  // Settings
  timePerQuestion   Int           @default(20) // seconds
  pointsPerQuestion Int           @default(1000)
  playMusic         Boolean       @default(true)
  playSound         Boolean       @default(true)
  showAnswerAfter   Boolean       @default(true)
  allowLateJoin     Boolean       @default(false)

  // Questions (JSON array of question objects or IDs)
  questions         String        // JSON stringified array

  // Timestamps
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime

  // Relations
  participants      Participant[]
  answers           Answer[]

  @@index([accessCode])
  @@index([hostId])
  @@index([status])
  @@index([createdAt])
}

model Participant {
  id            String      @id
  sessionId     String
  nickname      String
  avatar        String?     // Color code or emoji
  score         Int         @default(0)
  streak        Int         @default(0)
  rank          Int?
  isActive      Boolean     @default(true)
  joinedAt      DateTime    @default(now())

  // Relations
  session       QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@index([sessionId])
  @@index([score])
}

model Answer {
  id              String      @id
  sessionId       String
  participantId   String
  questionIndex   Int         // Which question (0-based)
  selectedOption  Int         // Selected answer index (0-based)
  isCorrect       Boolean
  timeToAnswer    Int         // milliseconds
  pointsEarned    Int
  answeredAt      DateTime    @default(now())

  // Relations
  session         QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId, questionIndex])
  @@index([sessionId])
  @@index([participantId])
  @@index([questionIndex])
}

// ============================================
// CONTENT VERSIONING & AUDIT LOGGING
// For healthcare compliance and content tracking
// ============================================

model ContentVersion {
  id              String   @id
  resourceType    String   // 'question', 'evidence', 'topic', etc.
  resourceId      String   // ID of the resource being versioned
  version         Int      // Version number (1, 2, 3, etc.)
  content         String   // JSON snapshot of the content at this version
  changes         String?  // Description of what changed
  changedBy       String   // User ID who made the change
  changeReason    String?  // Reason for the change
  isActive        Boolean  @default(false) // Only one version should be active
  createdAt       DateTime @default(now())

  @@unique([resourceType, resourceId, version])
  @@index([resourceType])
  @@index([resourceId])
  @@index([isActive])
  @@index([createdAt])
  @@index([changedBy])
}

model AuditLog {
  id             String   @id
  action         String   // Action performed (e.g., 'user.login', 'content.update')
  userId         String?  // User who performed the action
  userEmail      String?  // Email for easier searching
  resourceType   String?  // Type of resource affected
  resourceId     String?  // ID of resource affected
  details        String?  // JSON with additional details
  ipAddress      String?  // IP address of the request
  userAgent      String?  // Browser/device info
  success        Boolean  // Whether action was successful
  errorMessage   String?  // Error message if failed
  timestamp      DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([userEmail])
  @@index([resourceType])
  @@index([timestamp])
  @@index([success])
}

model CitationVerification {
  id              String   @id
  evidenceId      String   // Reference to EvidenceReference
  pmid            String?  // PubMed ID
  doi             String?  // Digital Object Identifier
  url             String?  // Original URL
  status          String   @default("pending") // pending, verified, broken, retracted
  lastChecked     DateTime @default(now())
  isRetracted     Boolean  @default(false)
  retractionNote  String?
  responseCode    Int?     // HTTP response code
  errorMessage    String?
  verifiedBy      String?  // User or system that verified
  nextCheckDate   DateTime? // When to check next
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([evidenceId])
  @@index([status])
  @@index([lastChecked])
  @@index([isRetracted])
  @@index([nextCheckDate])
}

