// ECCCO Platform Prisma Schema - Production (PostgreSQL) v2.0
// This schema is used for production deployments with PostgreSQL
// Updated: 2025-11-09 to fix client caching issues

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String?       @unique
  name          String?
  sessionId     String        @unique // Browser session identifier for anonymous users
  examSessions  ExamSession[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([sessionId])
}

model Module {
  id          String    @id @default(cuid())
  name        String    @unique // "Pediatric Emergency Medicine", "Adult Emergency Medicine"
  description String?
  ageGroup    String    // "pediatric", "adult"
  isActive    Boolean   @default(true)
  topics      Topic[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ageGroup])
}

model Topic {
  id           String        @id @default(cuid())
  name         String        
  description  String?
  
  // Module relationship
  moduleId     String
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  // Topic categorization
  category     String        @default("general") // "ventilation", "electrolytes", "sepsis", "fluid_resuscitation", etc.
  subcategory  String?       // Optional subcategorization for more granular organization
  
  questions    Question[]
  examSessions ExamSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([moduleId, name]) // Topic names should be unique within a module
  @@index([moduleId])
  @@index([category])
}

model Question {
  id           String   @id @default(cuid())
  question     String
  options      String   // JSON string of options array
  correctIndex Int      // Index of correct answer (0-based)
  explanation  String
  references   String   // JSON string of references array
  difficulty   String   @default("medium") // easy, medium, hard
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([topicId])
  @@index([difficulty])
}

model ExamSession {
  id               String   @id @default(cuid())
  userId           String?  // Optional user ID for registered users
  user             User?    @relation(fields: [userId], references: [id])
  sessionId        String   // Browser session identifier for anonymous tracking
  topicId          String
  topic            Topic    @relation(fields: [topicId], references: [id])
  topicName        String   // Topic name for analytics (denormalized for performance)
  questions        String   // JSON string of question IDs array
  questionsData    String?  // JSON string of complete question data for analytics
  answers          String   // JSON string of user answers array
  answersData      String?  // JSON string of detailed answer data for analytics
  score            Int?     // Score as percentage
  totalQuestions   Int      @default(0) // Total number of questions in session
  correctAnswers   Int      @default(0) // Number of correct answers
  totalTime        Int?     // Time taken in seconds
  timeSpent        Int?     // Time spent in seconds (analytics field)
  completed        Boolean  @default(false)
  completedAt      DateTime? // When the session was completed
  metadata         String?  // JSON string for additional metadata (user agent, difficulty, etc.)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([topicId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([completedAt])
}