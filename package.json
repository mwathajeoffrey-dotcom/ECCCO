    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.12.1",
    "ioredis": "^5.8.2",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.552.0",
    "next": "^16.1.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "prisma": "^6.18.0",
