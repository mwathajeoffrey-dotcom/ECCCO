{
  "name": "eccco-exam-platform",
  "version": "1.0.0",
  "description": "Emergency & Critical Care Comprehensive Online - Medical Education Platform",
  "private": true,
  "author": "ECCCO Team",
  "license": "MIT",
  "homepage": "https://eccco-platform.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwathajeoffrey-dotcom/ECCCO.git"
  },
  "keywords": [
    "medical-education",
    "emergency-medicine",
    "critical-care",
    "exam-platform",
    "nextjs",
    "prisma"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze": "cross-env ANALYZE=true next build",
    "clean": "rm -rf .next out"
  },
